<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Carrinho - The Office Papelaria</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/CSS/carrinho.pt.css">
    <style>
        body { background-color: #ebe5d8; font-family: 'Poppins', sans-serif; color: #1a1a1a; margin: 0; }
        .top-header { background-color: #f7f3e8; border-bottom: 1px solid #e4decb; padding: 0.75rem 0; }
        .header-inner { max-width: 1200px; margin: 0 auto; padding: 0 2rem; display: flex; align-items: center; justify-content: space-between; }
        .logo img { height: 40px; display: block; }
        .main-nav ul { list-style: none; display: flex; gap: 2rem; margin: 0; padding: 0; }
        .main-nav a { text-decoration: none; color: #2b2b2b; font-size: 0.88rem; font-weight: 500; }
        .header-icons { display: flex; align-items: center; gap: 1rem; }
        .header-icons a { color: #1a1a1a; font-size: 1.2rem; text-decoration: none; position: relative; }
        .cart-badge {
            position: absolute; top: -6px; right: -9px;
            background-color: #f6c95c; color: #1a1a1a;
            font-size: 0.65rem; font-weight: 700;
            width: 17px; height: 17px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
        }
        .cart-container { max-width: 1120px; margin: 2.2rem auto 4rem auto; padding: 0 2rem; }
        .cart-grid { display: grid; grid-template-columns: 1fr 340px; gap: 1.6rem; align-items: start; }
        .cart-box, .summary-box {
            background-color: #faf7f0;
            border-radius: 22px;
            padding: 1.6rem;
            box-shadow: 0 4px 16px rgba(0,0,0,0.03);
            border: 1px solid #e6dfd0;
        }
        .cart-item {
            display: flex; align-items: center; justify-content: space-between;
            gap: 1rem; padding: 1rem 0; border-bottom: 1px solid #ebe4d5;
        }
        .cart-item:last-child { border-bottom: none; }
        .item-left { display: flex; align-items: center; gap: 1rem; }
        .item-thumb {
            width: 68px; height: 68px; background: #ebe4d5; border-radius: 12px;
            display: flex; align-items: center; justify-content: center; padding: 6px;
        }
        .item-thumb img { max-width: 100%; max-height: 100%; object-fit: contain; }
        .qty-box { display: inline-flex; align-items: center; gap: 0.5rem; background: #f3eee3; padding: 0.25rem 0.6rem; border-radius: 20px; }
        .qty-box button { border: none; background: transparent; font-weight: 700; cursor: pointer; font-size: 1rem; }
        .btn-checkout {
            width: 100%; background-color: #f6c95c; color: #1a1a1a;
            border: none; border-radius: 24px; padding: 0.85rem;
            font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.92rem;
            cursor: pointer; margin-top: 1rem;
        }
        .btn-checkout:hover { background-color: #e8b845; }
        @media (max-width: 820px) { .cart-grid { grid-template-columns: 1fr; } }
    </style>
</head>

<body>
    <header class="top-header">
        <div class="header-inner">
            <div class="logo">
                <a href="/"><img src="/IMG/Landing/logo.png" alt="The Office Papelaria"></a>
            </div>

            <nav class="main-nav">
                <ul>
                    <li><a href="/">Início</a></li>
                    <li><a href="/#sobre">Sobre nós</a></li>
                    <li><a href="/catalogo">Produtos</a></li>
                    <% if (usuario && usuario.tipo === 'admin') { %>
                        <li><a href="/dashboard">Painel Admin</a></li>
                    <% } %>
                </ul>
            </nav>

            <div class="header-icons">
                <% if (usuario) { %>
                    <a href="/meus-pedidos" title="Meus Pedidos"><i class="bi bi-person-fill"></i></a>
                    <a href="/logout" title="Sair"><i class="bi bi-box-arrow-right"></i></a>
                <% } else { %>
                    <a href="/login" title="Entrar"><i class="bi bi-person"></i></a>
                <% } %>
                <a href="/carrinho" title="Carrinho">
                    <i class="bi bi-cart3"></i>
                    <% if (typeof qtdCarrinho !== 'undefined' && qtdCarrinho > 0) { %>
                        <span class="cart-badge"><%= qtdCarrinho %></span>
                    <% } %>
                </a>
            </div>
        </div>
    </header>

    <main class="cart-container">
        <h1 style="font-size: 1.7rem; margin-bottom: 0.3rem;">Meu Carrinho</h1>
        <p style="font-size: 0.88rem; color: #555; margin-bottom: 1.5rem;">Revise os itens selecionados antes de finalizar sua compra.</p>

        <% if (typeof erro !== 'undefined' && erro) { %>
            <div style="background:#fed7d7; color:#822727; padding:0.85rem 1.2rem; border-radius:14px; margin-bottom:1.2rem; font-size:0.85rem; font-weight:500;">
                <i class="bi bi-exclamation-circle-fill"></i> <%= erro %>
            </div>
        <% } %>

        <% if (carrinho && carrinho.length > 0) { %>
            <div class="cart-grid">
                <div class="cart-box">
                    <% carrinho.forEach(item => { %>
                        <div class="cart-item">
                            <div class="item-left">
                                <div class="item-thumb">
                                    <img src="<%= item.imagem_url || '/IMG/Landing/placeholder.png' %>" alt="<%= item.nome %>">
                                </div>
                                <div>
                                    <h3 style="font-size: 0.96rem; margin: 0 0 0.2rem 0;"><%= item.nome %></h3>
                                    <span style="font-size: 0.85rem; color: #555;">Unitário: <strong><%= moeda(item.preco_unitario) %></strong></span>
                                </div>
                            </div>

                            <div style="display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap;">
                                <div class="qty-box">
                                    <form action="/carrinho/atualizar" method="POST" style="margin:0;">
                                        <input type="hidden" name="produto_id" value="<%= item.produto_id %>">
                                        <input type="hidden" name="acao" value="diminuir">
                                        <button type="submit">&minus;</button>
                                    </form>
                                    <span style="font-weight: 600; font-size: 0.9rem;"><%= item.quantidade %></span>
                                    <form action="/carrinho/atualizar" method="POST" style="margin:0;">
                                        <input type="hidden" name="produto_id" value="<%= item.produto_id %>">
                                        <input type="hidden" name="acao" value="aumentar">
                                        <button type="submit">+</button>
                                    </form>
                                </div>

                                <span style="font-weight: 700; min-width: 85px; text-align: right;">
                                    <%= moeda(item.preco_unitario * item.quantidade) %>
                                </span>

                                <form action="/carrinho/remover/<%= item.produto_id %>" method="POST" style="margin:0;">
                                    <button type="submit" style="background:none; border:none; color:#c53030; cursor:pointer; font-size:1.05rem;" title="Remover">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="summary-box">
                    <h2 style="font-size: 1.15rem; margin-bottom: 1rem;">Resumo do Pedido</h2>
                    <div style="display:flex; justify-content:space-between; margin-bottom:0.6rem; font-size:0.88rem;">
                        <span>Itens (<%= qtdCarrinho %>)</span>
                        <span><%= moeda(totalCarrinho) %></span>
                    </div>
                    <hr style="border:none; border-top:1px solid #e6dfd0; margin:0.9rem 0;">
                    <div style="display:flex; justify-content:space-between; font-size:1.08rem; font-weight:700;">
                        <span>Total</span>
                        <span><%= moeda(totalCarrinho) %></span>
                    </div>

                    <form action="/pedidos/finalizar" method="POST">
                        <button type="submit" class="btn-checkout">Finalizar Compra</button>
                    </form>

                    <a href="/catalogo" style="display:block; text-align:center; margin-top:0.9rem; font-size:0.82rem; color:#444; text-decoration:none;">
                        &larr; Continuar comprando
                    </a>
                </div>
            </div>
        <% } else { %>
            <div class="cart-box" style="text-align: center; padding: 3rem 1.5rem;">
                <i class="bi bi-cart-x" style="font-size: 2.5rem; color: #999;"></i>
                <h2 style="font-size: 1.2rem; margin: 0.8rem 0 0.4rem 0;">Seu carrinho está vazio</h2>
                <p style="font-size: 0.86rem; color: #666; margin-bottom: 1.4rem;">Adicione produtos da loja para continuar.</p>
                <a href="/catalogo" style="display:inline-block; background:#f6c95c; color:#1a1a1a; padding:0.7rem 1.8rem; border-radius:22px; text-decoration:none; font-weight:600; font-size:0.86rem;">
                    Ver Produtos
                </a>
            </div>
        <% } %>
    </main>
</body>
</html>